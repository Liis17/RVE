#version 450

layout(local_size_x = PARTICLE_LOCAL_SIZE) in;

// Параметры эмиттера; совпадает с EmitterParamsGpu в particles.rs.
layout(set = 1, binding = 0, std140) uniform EmitterParams {
    vec4 shape;
    vec4 box_extents;
    vec4 lifetime_speed;
    vec4 size_rotation;
    vec4 angular_drag;
    vec4 gravity;
    vec4 color_times;
    vec4 color_values[4];
    vec4 size_times;
    vec4 size_values;
    vec4 flipbook;
    vec4 collision;
    uvec4 counts;
} emitter;

// Совпадает с ParticleGpu в particles.rs: три vec4.
struct Particle {
    vec4 position_age;
    vec4 velocity_life;
    vec4 params;
};

layout(set = 1, binding = 1, std430) buffer ParticleBuffer {
    Particle particles[];
} particle_buffer;

// Совпадает с SpawnPushGpu в particles.rs (112 байт).
layout(push_constant) uniform SpawnPush {
    mat4 transform;
    uint first_slot;
    uint count;
    uint serial_low;
    uint serial_high;
    uint capacity;
    float step;
    float fixed_age;
    uint fixed_pre_age;
    uint seed;
    uint padding0;
    uint padding1;
    uint padding2;
} push;

uint pcg_hash(uint input_value) {
    uint state = input_value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float particle_random(uint seed, uint serial_low, uint serial_high, uint channel) {
    uint serial_fold = serial_low ^ (serial_high * 0x9E3779B9u);
    uint hashed = pcg_hash(pcg_hash(seed ^ serial_fold) ^ (channel * 0x85EBCA6Bu));
    return float(hashed) / 4294967296.0;
}

vec3 random_direction(uint seed, uint serial_low, uint serial_high, uint channel) {
    float z = 2.0 * particle_random(seed, serial_low, serial_high, channel) - 1.0;
    float phi = 6.28318530718 * particle_random(seed, serial_low, serial_high, channel + 1u);
    float radial = sqrt(max(0.0, 1.0 - z * z));
    return vec3(radial * cos(phi), z, radial * sin(phi));
}

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= push.count) {
        return;
    }
    uint serial_low = push.serial_low + k;
    uint serial_high = push.serial_high + (serial_low < push.serial_low ? 1u : 0u);
    uint slot = (push.first_slot + k) % push.capacity;
    uint seed = push.seed;

    float pre_age = push.fixed_pre_age == 1u
        ? push.fixed_age
        : particle_random(seed, serial_low, serial_high, 0u) * push.step;
    // Частица рождается внутри шага, поэтому стартовый возраст отрицателен; симуляция добавит шаг.
    float start_age = pre_age - push.step;

    int kind = int(emitter.shape.x);
    vec3 local_position = vec3(0.0);
    vec3 local_direction = vec3(0.0, 1.0, 0.0);
    if (kind == 1) {
        local_direction = random_direction(seed, serial_low, serial_high, 1u);
        local_position = local_direction * emitter.shape.y;
    } else if (kind == 0) {
        local_direction = random_direction(seed, serial_low, serial_high, 1u);
    } else if (kind == 2) {
        float cone_angle = emitter.shape.y;
        float cos_theta = mix(cos(cone_angle), 1.0, particle_random(seed, serial_low, serial_high, 1u));
        float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
        float phi = 6.28318530718 * particle_random(seed, serial_low, serial_high, 2u);
        local_direction = vec3(sin_theta * cos(phi), cos_theta, sin_theta * sin(phi));
        float disc_radius = emitter.shape.z * sqrt(particle_random(seed, serial_low, serial_high, 3u));
        float disc_angle = 6.28318530718 * particle_random(seed, serial_low, serial_high, 4u);
        local_position = vec3(disc_radius * cos(disc_angle), 0.0, disc_radius * sin(disc_angle));
    } else {
        vec3 unit = vec3(
            particle_random(seed, serial_low, serial_high, 1u),
            particle_random(seed, serial_low, serial_high, 2u),
            particle_random(seed, serial_low, serial_high, 3u)) * 2.0 - 1.0;
        local_position = unit * emitter.box_extents.xyz;
    }

    float speed = mix(emitter.lifetime_speed.z, emitter.lifetime_speed.w, particle_random(seed, serial_low, serial_high, 5u));
    float lifetime = mix(emitter.lifetime_speed.x, emitter.lifetime_speed.y, particle_random(seed, serial_low, serial_high, 6u));
    float size = mix(emitter.size_rotation.x, emitter.size_rotation.y, particle_random(seed, serial_low, serial_high, 7u));
    float rotation = mix(emitter.size_rotation.z, emitter.size_rotation.w, particle_random(seed, serial_low, serial_high, 8u));
    float angular = mix(emitter.angular_drag.x, emitter.angular_drag.y, particle_random(seed, serial_low, serial_high, 9u));
    float flip_random = particle_random(seed, serial_low, serial_high, 10u);

    vec3 world_position = (push.transform * vec4(local_position, 1.0)).xyz;
    vec3 world_velocity = mat3(push.transform) * (local_direction * speed);

    Particle particle;
    particle.position_age = vec4(world_position + world_velocity * start_age, start_age);
    particle.velocity_life = vec4(world_velocity, lifetime);
    particle.params = vec4(size, rotation, angular, flip_random);
    particle_buffer.particles[slot] = particle;
}
