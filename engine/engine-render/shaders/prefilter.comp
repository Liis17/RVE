#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform textureCube source_texture;
layout(set = 0, binding = 1) uniform sampler source_sampler;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2DArray output_image;
layout(set = 0, binding = 3, std140) uniform EnvironmentParams {
    vec4 pass_params;
    vec4 sun_direction_intensity;
    vec4 zenith_color;
    vec4 horizon_color;
    vec4 ground_color;
} params;

const float PI = 3.14159265358979323846;
const uint SAMPLE_COUNT = 128u;

vec3 cube_direction(int face, vec2 uv) {
    if (face == 0) return normalize(vec3(1.0, -uv.y, -uv.x));
    if (face == 1) return normalize(vec3(-1.0, -uv.y, uv.x));
    if (face == 2) return normalize(vec3(uv.x, 1.0, uv.y));
    if (face == 3) return normalize(vec3(uv.x, -1.0, -uv.y));
    if (face == 4) return normalize(vec3(uv.x, -uv.y, 1.0));
    return normalize(vec3(-uv.x, -uv.y, -1.0));
}

float radical_inverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec3 importance_sample_ggx(vec2 xi, vec3 normal, float roughness) {
    float alpha = max(roughness * roughness, 0.001);
    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
    float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
    vec3 half_local = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * half_local.x + bitangent * half_local.y + normal * half_local.z);
}

void main() {
    uvec3 invocation = gl_GlobalInvocationID;
    uint size = uint(params.pass_params.x);
    if (invocation.x >= size || invocation.y >= size || invocation.z >= 6u) return;
    vec2 uv = (vec2(invocation.xy) + vec2(0.5)) / float(size) * 2.0 - 1.0;
    vec3 normal = cube_direction(int(invocation.z), uv);
    float roughness = params.pass_params.y;
    if (roughness < 0.0) {
        // Average the four texels of the preceding radiance mip. Sampling
        // texel centers avoids losing small bright sources at coarser levels.
        vec3 average = vec3(0.0);
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                vec2 source_uv = (vec2(invocation.xy) * 2.0
                    + vec2(float(x), float(y)) + vec2(0.5)) / (2.0 * float(size)) * 2.0 - 1.0;
                average += textureLod(samplerCube(source_texture, source_sampler),
                    cube_direction(int(invocation.z), source_uv), params.pass_params.w).rgb * 0.25;
            }
        }
        imageStore(output_image, ivec3(invocation), vec4(clamp(average, vec3(0.0), vec3(65504.0)), 1.0));
        return;
    }
    if (roughness <= 0.001) {
        vec3 color = textureLod(samplerCube(source_texture, source_sampler), normal, 0.0).rgb;
        imageStore(output_image, ivec3(invocation), vec4(clamp(color, vec3(0.0), vec3(65504.0)), 1.0));
        return;
    }
    vec3 view = normal;
    vec3 color = vec3(0.0);
    float weight = 0.0;
    float alpha = max(roughness * roughness, 0.001);
    float alpha_squared = alpha * alpha;
    float texel_solid_angle = 4.0 * PI / (6.0 * params.pass_params.z * params.pass_params.z);
    for (uint index = 0u; index < SAMPLE_COUNT; ++index) {
        vec2 xi = vec2(float(index) / float(SAMPLE_COUNT), radical_inverse(index));
        vec3 half_vector = importance_sample_ggx(xi, normal, roughness);
        vec3 light = normalize(2.0 * dot(view, half_vector) * half_vector - view);
        float n_dot_l = max(dot(normal, light), 0.0);
        if (n_dot_l > 0.0) {
            float n_dot_h = max(dot(normal, half_vector), 0.0);
            float v_dot_h = max(dot(view, half_vector), 1e-5);
            float denominator = n_dot_h * n_dot_h * (alpha_squared - 1.0) + 1.0;
            float distribution = alpha_squared / (PI * denominator * denominator);
            float pdf = max(distribution * n_dot_h / (4.0 * v_dot_h), 1e-5);
            float sample_solid_angle = 1.0 / (float(SAMPLE_COUNT) * pdf);
            float source_lod = max(0.0, 0.5 * log2(sample_solid_angle / texel_solid_angle));
            color += textureLod(
                samplerCube(source_texture, source_sampler), light, source_lod
            ).rgb * n_dot_l;
            weight += n_dot_l;
        }
    }
    imageStore(output_image, ivec3(invocation), vec4(clamp(color / max(weight, 1e-5), vec3(0.0), vec3(65504.0)), 1.0));
}
