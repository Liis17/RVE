#version 450

// Skinning: переводит вершины меша в пространство модели по палитре костей кадра.
// Вершина Vertex занимает 11 float: позиция, нормаль, uv и цвет. Чтение через массив float
// обходит выравнивание vec3 в std430 и совпадает с раскладкой Rust-структуры.

layout(local_size_x = SKIN_COMPUTE_LOCAL_SIZE) in;

layout(set = 0, binding = 0, std430) readonly buffer SourceVertices {
    float values[];
} source_vertices;

struct SkinInfluence {
    uvec4 joints;
    vec4 weights;
};

layout(set = 0, binding = 1, std430) readonly buffer SkinInfluences {
    SkinInfluence influences[];
} skin_influences;

layout(set = 0, binding = 2, std430) readonly buffer JointPalette {
    mat4 matrices[];
} joint_palette;

layout(set = 0, binding = 3, std430) buffer OutputVertices {
    float values[];
} output_vertices;

layout(push_constant) uniform SkinParams {
    uint vertex_count;
} params;

void main() {
    uint vertex = gl_GlobalInvocationID.x;
    if (vertex >= params.vertex_count) {
        return;
    }
    uint base = vertex * 11u;
    vec3 position = vec3(
        source_vertices.values[base],
        source_vertices.values[base + 1u],
        source_vertices.values[base + 2u]);
    vec3 normal = vec3(
        source_vertices.values[base + 3u],
        source_vertices.values[base + 4u],
        source_vertices.values[base + 5u]);

    SkinInfluence influence = skin_influences.influences[vertex];
    vec3 skinned_position = vec3(0.0);
    vec3 skinned_normal = vec3(0.0);
    float total_weight = 0.0;
    for (int slot = 0; slot < 4; ++slot) {
        float weight = influence.weights[slot];
        if (weight <= 0.0) {
            continue;
        }
        mat4 matrix = joint_palette.matrices[influence.joints[slot]];
        skinned_position += (matrix * vec4(position, 1.0)).xyz * weight;
        skinned_normal += mat3(matrix) * normal * weight;
        total_weight += weight;
    }
    if (total_weight <= 0.0) {
        skinned_position = position;
        skinned_normal = normal;
    }
    float normal_length = length(skinned_normal);
    if (normal_length > 0.0) {
        skinned_normal /= normal_length;
    }

    output_vertices.values[base] = skinned_position.x;
    output_vertices.values[base + 1u] = skinned_position.y;
    output_vertices.values[base + 2u] = skinned_position.z;
    output_vertices.values[base + 3u] = skinned_normal.x;
    output_vertices.values[base + 4u] = skinned_normal.y;
    output_vertices.values[base + 5u] = skinned_normal.z;
    output_vertices.values[base + 6u] = source_vertices.values[base + 6u];
    output_vertices.values[base + 7u] = source_vertices.values[base + 7u];
    output_vertices.values[base + 8u] = source_vertices.values[base + 8u];
    output_vertices.values[base + 9u] = source_vertices.values[base + 9u];
    output_vertices.values[base + 10u] = source_vertices.values[base + 10u];
}
