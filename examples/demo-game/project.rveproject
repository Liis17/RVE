id = "demo-game"
name = "RVE Demo"
version = "1.0.0"
heavy_scripts = "HeavyScripts"

[input]
default_context = "game"

[input.contexts.game.Jump]
kind = "button"
inputs = ["Space"]

[input.contexts.game.Move]
kind = "vector2"
up = ["W"]
down = ["S"]
left = ["A"]
right = ["D"]

[input.contexts.game.Escape]
kind = "button"
inputs = ["Escape"]

[input.contexts.game.fire]
kind = "button"
inputs = ["Mouse.Left"]

[input.contexts.game.spawn_heavy]
kind = "button"
inputs = ["T"]

[input.contexts.menu.Escape]
kind = "button"
inputs = ["Escape"]

# Первая включённая сцена — стартовая; физическая демо-сцена запускается первой.
[[scenes]]
path = "/scenes/physics.rvescene"
enabled = true

[[scenes]]
path = "/scenes/main.rvescene"
enabled = true

[[scenes]]
path = "/scenes/second.rvescene"
enabled = true

[[scenes]]
path = "/scenes/draft.rvescene"
enabled = false
