[[assets]]
path = "/models/shared-cube.fbx"

[[assets]]
path = "/cameras/default.camerasettings"

[[assets]]
path = "/scripts/rotate.lua"

[[assets]]
path = "/prefabs/orbit.rveprefab"

[[objects]]
id = "camera"
name = "Camera"
[objects.transform]
position = [0.0, 1.15, 6.0]
[objects.camera]
settings = "/cameras/default.camerasettings"

[[objects]]
id = "sun"
name = "Directional Light"
[objects.transform]
rotation = [-35.0, 30.0, 0.0]
[objects.directional_light]
color = [1.0, 0.95, 0.82]
ambient = [0.18, 0.18, 0.2]
shadows = true
shadow_distance = 80.0
shadow_cascades = 4

[[objects]]
id = "environment"
name = "Environment"
[objects.environment]
intensity = 1.0
skybox = true
[objects.environment.procedural]
zenith_color = [0.18, 0.32, 0.58]
horizon_color = [0.68, 0.74, 0.82]
ground_color = [0.12, 0.11, 0.10]
sun_size_deg = 1.0
sun_intensity = 1.0

[[objects]]
id = "lighting-rig"
name = "Local Lights"
[objects.transform]
position = [0.0, 0.0, 0.0]
rotation = [0.0, 8.0, 0.0]
scale = [1.25, 0.9, 1.1]

[[objects]]
id = "warm-point"
name = "Warm Point Light"
parent = "lighting-rig"
[objects.transform]
position = [-2.4, 2.2, 1.2]
[objects.point_light]
color = [1.0, 0.42, 0.16]
intensity = 35.0
range = 9.0
shadows = true

[[objects]]
id = "cool-spot"
name = "Cool Spot Light"
parent = "lighting-rig"
[objects.transform]
position = [2.4, 3.2, 1.5]
rotation = [-32.0, -38.0, 0.0]
[objects.spot_light]
color = [0.22, 0.52, 1.0]
intensity = 48.0
range = 11.0
inner_angle_deg = 14.0
outer_angle_deg = 28.0
shadows = true

[[objects]]
id = "shared-cube"
name = "Shared Cube"
[objects.transform]
position = [0.0, 1.15, 0.0]
[objects.mesh_renderer]
model = "/models/shared-cube.fbx"
[objects.mesh_renderer.material]
metallic = 0.55
roughness = 0.32
[[objects.lite_scripts]]
path = "/scripts/rotate.lua"
params = { speed = 30.0 }
[[objects.heavy_scripts]]
name = "Bobber"
params = { amplitude = 0.15, speed = 1.4 }

[[objects]]
id = "shadow-floor"
name = "Shadow Floor"
[objects.transform]
position = [0.0, 0.35, 0.0]
scale = [8.0, 0.2, 8.0]
[objects.mesh_renderer]
model = "/models/shared-cube.fbx"
[objects.mesh_renderer.material]
metallic = 0.0
roughness = 0.85

[[instances]]
id = "orbit"
prefab = "/prefabs/orbit.rveprefab"
[instances.transform]
position = [0.0, 1.15, 0.0]

[[instances.overrides]]
target = "moon"
name = "Moon"
lite_params = [{ path = "/scripts/rotate.lua", params = { speed = -120.0 } }]
