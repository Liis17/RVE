[[assets]]
path = "/models/shared-cube.fbx"

[[assets]]
path = "/cameras/default.camerasettings"

[[assets]]
path = "/models/props-cube.fbx"
archive = "props"

[[assets]]
path = "/prefabs/satellite.rveprefab"

[[assets]]
path = "/scripts/rotate.lua"

[[assets]]
path = "/models/worm.fbx"

[[assets]]
path = "/anims/worm_curl.fbx"

[[assets]]
path = "/scripts/worm.lua"

[[objects]]
id = "camera"
name = "Camera"
[objects.transform]
position = [0.0, 1.0, 8.0]
[objects.camera]
settings = "/cameras/default.camerasettings"

[[objects]]
id = "sun"
name = "Directional Light"
[objects.transform]
rotation = [-35.0, 30.0, 0.0]
[objects.directional_light]
color = [1.0, 0.95, 0.82]
ambient = [0.18, 0.18, 0.2]
shadows = true
shadow_distance = 80.0
shadow_cascades = 4

[[objects]]
id = "shared-cube"
name = "Shared Cube"
[objects.transform]
position = [-1.1, 1.0, 0.0]
[objects.mesh_renderer]
model = "/models/shared-cube.fbx"
[[objects.lite_scripts]]
path = "/scripts/rotate.lua"
params = { speed = 24.0 }

[[objects]]
id = "props-cube"
name = "Props Cube"
[objects.transform]
position = [1.1, 0.75, 0.0]
scale = [0.75, 0.75, 0.75]
[objects.mesh_renderer]
model = "/models/props-cube.fbx"

[[instances]]
id = "satellite-demo"
prefab = "/prefabs/satellite.rveprefab"
[instances.transform]
position = [0.0, 2.0, 0.0]

[[objects]]
id = "worm"
name = "Worm"
[objects.transform]
position = [2.8, 0.0, -1.0]
[objects.mesh_renderer]
model = "/models/worm.fbx"
[objects.animator]
clips = ["/anims/worm_curl.fbx"]
play_on_start = false
[[objects.lite_scripts]]
path = "/scripts/worm.lua"
